{
  "name": "tetrlang",
  "type": "module",
  "version": "0.0.1",
  "description": "a Tetris language",
  "author": "Harlos <murataharu0517@gmail.com>",
  "license": "MIT",
  "scripts": {
    "lint": "eslint",
    "build": "pnpm --filter tetrlang-core build && pnpm --filter tetrlang-renderer build",
    "renderer": "pnpm --filter tetrlang-renderer",
    "bot": "pnpm --filter tetrlang-discord start",
    "bot:dev": "pnpm --filter tetrlang-discord dev"
  },
  "dependencies": {
    "tetrlang-core": "workspace:*",
    "tetrlang-renderer": "workspace:*",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.0",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "typescript-eslint": "^8.60.1",
    "typescript": "^6.0.3"
  }
}